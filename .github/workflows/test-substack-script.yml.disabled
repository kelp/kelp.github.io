name: Test Substack Publishing Script

on:
  push:
    paths:
      - '.github/scripts/publish_to_substack.py'
      - '.github/scripts/tests/**'
      - '.github/workflows/test-substack-script.yml'
  pull_request:
    paths:
      - '.github/scripts/publish_to_substack.py'
      - '.github/scripts/tests/**'
  workflow_dispatch:

jobs:
  test:
    runs-on: ubuntu-latest
    name: Run Python Tests
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v3
      
      - name: Set up Python 3.10
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'
      
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install pytest pytest-cov
          pip install pyyaml markdown requests python-frontmatter
      
      - name: Run tests
        run: |
          cd .github/scripts
          python -m pytest tests/test_publish_to_substack.py -v --cov=. --cov-report=xml
      
      - name: Upload coverage report
        uses: codecov/codecov-action@v3
        with:
          file: .github/scripts/coverage.xml
          fail_ci_if_error: false